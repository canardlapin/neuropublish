# Copy to a file outside the repository, replace every change-me value, then pass it with
# `docker compose --env-file /secure/path/alpha.env -f ops/compose.alpha.yml ...`.
NP_BASE_URL=https://neuropublish.example.org
NP_ALPHA_PORT=8080
NP_MINIO_PORT=9000
NP_WORKSPACE=rotman
NP_PROJECT=sherlock
NP_OWNER_EMAIL=owner@example.org
NP_OWNER_PASSWORD=change-me-owner-password
NP_POSTGRES_PASSWORD=change-me-postgres-password
NP_MINIO_ROOT_USER=change-me-minio-user
NP_MINIO_ROOT_PASSWORD=change-me-minio-password
